{
  "schema_version": 1,
  "benchmark_type": "multiagent",
  "scoring": "task",
  "execution_mode": "shared_container",
  "name": "hermes-sol-deepseek-four-task",
  "dataset": "terminal-bench/terminal-bench-2-1",
  "task_ids": [
    "pypi-server",
    "fix-code-vulnerability",
    "qemu-startup",
    "sanitize-git-repo"
