  "harness": {"id": "hermes_agent", "version": "0.20.0"},
  "orchestrator": {"model": "openai/gpt-6.1-sol", "reasoning_effort": "high", "max_output_tokens": 8192, "max_calls": 150, "api": "responses"},
  "executor": {"model": "~deepseek/deepseek-v4-flash-latest", "reasoning_effort": "medium", "max_output_tokens": 8192, "max_calls": 150, "api": "chat"},
  "max_parallel_workers": null,
  "batch_timeout_seconds": 900,
  "worker_timeout_seconds": 900,
  "grading_reserve_seconds": 90,
  "max_cost_usd": null,
  "sandbox": {"image": "ubuntu:24.04", "platform": "linux/amd64", "shared_cpus": 4, "shared_memory_gb": 5}
}
