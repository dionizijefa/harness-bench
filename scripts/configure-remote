#!/usr/bin/env python3
"""Configure and bootstrap the private SSH rollout worker."""

import argparse
import json
import shlex
import subprocess
from pathlib import Path


def run(command: list[str]) -> None:
    subprocess.run(command, check=True)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Configure an SSH host as the default Dagster rollout worker."
    )
    parser.add_argument("host", help="Host or alias accepted by the local ssh command")
    parser.add_argument(
        "project_dir",
        nargs="?",
        help="Absolute project directory (default: ~/harness-bloat-bench on worker)",
    )
    args = parser.parse_args()

    if args.host.startswith("-") or any(char.isspace() for char in args.host):
        parser.error("host cannot start with '-' or contain whitespace")

    repo_root = Path(__file__).resolve().parent.parent
    private_dir = repo_root / ".dagster"
    private_dir.mkdir(exist_ok=True)

    print(f"Checking SSH connection to {args.host}...")
    run(["ssh", "--", args.host, "true"])

    project_dir = args.project_dir
    if project_dir is None:
        remote_home = subprocess.check_output(
            ["ssh", "--", args.host, 'printf "%s" "$HOME"'],
            text=True,
        ).strip()
        project_dir = f"{remote_home}/harness-bloat-bench"
    if not project_dir.startswith("/") or any(
        char.isspace() for char in project_dir
    ):
        parser.error("project_dir must be an absolute path without whitespace")

    remote_dir = shlex.quote(project_dir)
    run(["ssh", "--", args.host, f"mkdir -p -- {remote_dir}"])

    print(f"Syncing project to {args.host}:{project_dir}...")
    run(
        [
            "rsync",
            "-az",
            "--exclude",
            ".git",
            "--exclude",
            ".venv",
            "--exclude",
            ".dagster",
            "--exclude",
            ".env*",
            "--exclude",
            "outputs",
            f"{repo_root}/",
            f"{args.host}:{project_dir.rstrip('/')}/",
        ]
    )

    print("Installing the remote environment...")
    run(
        [
            "ssh",
            "--",
            args.host,
            'export PATH="$HOME/.local/bin:$PATH"; '
            f"cd {remote_dir} && uv sync",
        ]
    )

    config_path = private_dir / "remote.json"
    config_path.write_text(
        json.dumps(
            {
                "host": args.host,
                "project_dir": project_dir,
                "ssh_options": [],
                "copy_artifacts": True,
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    print(f"Configured private worker settings in {config_path}")
    print("Restart ./scripts/dagster-ui, then click Launch Run in Dagster.")


if __name__ == "__main__":
    main()
