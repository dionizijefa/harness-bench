#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ -f "$repo_root/.env" ]; then
    set -a
    . "$repo_root/.env"
    set +a
fi

private_dir="$repo_root/.dagster"
mkdir -p "$private_dir/runtime"
export DAGSTER_HOME="$private_dir/runtime"
export HARNESS_BLOAT_REMOTE_CONFIG="$private_dir/remote.json"

if [ ! -f "$DAGSTER_HOME/dagster.yaml" ]; then
    printf 'telemetry:\n  enabled: false\n' > "$DAGSTER_HOME/dagster.yaml"
fi

port_supplied=false
for arg in "$@"; do
    case "$arg" in
        --port | --port=*)
            port_supplied=true
            break
            ;;
    esac
done

if [ "$port_supplied" = false ]; then
    set -- --port "${DAGSTER_UI_PORT:-3210}" "$@"
fi

# Invoke Dagster through Python instead of its generated console script. The
# console script's shebang contains the absolute virtualenv path, so it stops
# working when this repository is renamed or moved.
uv run python -m dagster instance concurrency set rollouts "${HARNESS_BLOAT_ROLLOUT_SLOTS:-8}"
exec uv run python -m dagster dev -m harness_bloat_bench.definitions "$@"
