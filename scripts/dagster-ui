#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ -f "$repo_root/.env" ]; then
    set -a
    . "$repo_root/.env"
    set +a
fi

private_dir="$repo_root/.dagster"
mkdir -p "$private_dir/runtime"
export DAGSTER_HOME="$private_dir/runtime"
export HARNESS_BLOAT_REMOTE_CONFIG="$private_dir/remote.json"

if [ ! -f "$DAGSTER_HOME/dagster.yaml" ]; then
    printf 'telemetry:\n  enabled: false\n' > "$DAGSTER_HOME/dagster.yaml"
fi

uv run dagster instance concurrency set rollouts "${HARNESS_BLOAT_ROLLOUT_SLOTS:-6}"
exec uv run dagster dev -m harness_bloat_bench.definitions "$@"
